# ── App ──
FLASK_ENV=development
APP_NAME=NamVibe
APP_DOMAIN=namvibe.com
SECRET_KEY=change-me
PORT=5000

# ── Database ──
DATABASE_URL=postgresql://localhost:5432/namvibe
NEON_DATABASE_URL=

# ── Supabase Auth ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SITE_URL=https://namvibe.com
SUPABASE_AUTH_REDIRECT_URL=https://namvibe.com/auth/callback
GOOGLE_OAUTH_ENABLED=false
FACEBOOK_OAUTH_ENABLED=false

# ── Redis (session store, live presence, Socket.IO manager) ──
REDIS_URL=redis://localhost:6379/0
# Allow explicit shared local Redis fallback when the configured remote Redis is unavailable.
# Recommended for local development only.
CHAIN_REDIS_ALLOW_LOCAL_FALLBACK=0
CHAIN_LOCAL_REDIS_HOST=127.0.0.1
CHAIN_LOCAL_REDIS_PORT=6379
CHAIN_LOCAL_REDIS_DB=0
# Legacy worker-side background warming. Keep disabled in production.
CHAIN_ALLOW_WORKER_BACKGROUND_WARM=0

# ── LiveKit (WebRTC SFU for group calls & live streaming) ──
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_HOST=localhost:7880
LIVEKIT_WS_URL=ws://localhost:7880

# ── coturn (STUN/TURN for NAT traversal) ──
TURN_URL=turn:localhost:3478
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_REALM=namvibe.com

# ── FFmpeg (recording, replay, clip generation) ──
FFMPEG_PATH=/usr/local/bin/ffmpeg
FFPROBE_PATH=/usr/local/bin/ffprobe

# ── NamVibe AI Platform (optional, disabled by default) ──
NAMVIBE_AI_ENABLED=false
NAMVIBE_AI_PROVIDER=disabled
NAMVIBE_AI_MODEL=
NAMVIBE_AI_API_KEY=
NAMVIBE_AI_BASE_URL=
NAMVIBE_AI_TIMEOUT_SECONDS=12
NAMVIBE_AI_MAX_RETRIES=1
NAMVIBE_AI_RECOMMENDATIONS_ENABLED=false
NAMVIBE_AI_INTERACTION_TRACKING_ENABLED=true
NAMVIBE_AI_EXTERNAL_CALLS_ENABLED=false
NAMVIBE_AI_LOG_PROVIDER_USAGE=true
NAMVIBE_AI_CACHE_TTL_SECONDS=120
NAMVIBE_AI_RECOMMENDATION_VERSION=v1
