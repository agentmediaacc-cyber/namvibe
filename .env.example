# NamVibe environment template
# Use real secrets only in an approved secret manager or a local, untracked .env file.

FLASK_ENV=development
APP_NAME=NamVibe
APP_DOMAIN=YOUR_APP_DOMAIN
SECRET_KEY=GENERATE_A_STRONG_RANDOM_VALUE
PORT=5000

# Database
DATABASE_URL=postgresql://USERNAME:PASSWORD@YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require
NEON_DATABASE_URL=

# Supabase Auth
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SITE_URL=https://YOUR_APP_DOMAIN
SUPABASE_AUTH_REDIRECT_URL=https://YOUR_APP_DOMAIN/auth/callback
GOOGLE_OAUTH_ENABLED=false
FACEBOOK_OAUTH_ENABLED=false

# Redis (session store, live presence, Socket.IO manager)
REDIS_URL=rediss://default:YOUR_REDIS_TOKEN@YOUR_REDIS_HOST:6379/0
CHAIN_REDIS_ALLOW_LOCAL_FALLBACK=0
CHAIN_LOCAL_REDIS_HOST=127.0.0.1
CHAIN_LOCAL_REDIS_PORT=6379
CHAIN_LOCAL_REDIS_DB=0
CHAIN_ALLOW_WORKER_BACKGROUND_WARM=0

# LiveKit (WebRTC SFU for group calls & live streaming)
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
LIVEKIT_HOST=YOUR_LIVEKIT_HOST
LIVEKIT_WS_URL=wss://YOUR_LIVEKIT_HOST

# coturn (STUN/TURN for NAT traversal)
TURN_URL=turn:YOUR_TURN_HOST:3478
TURN_USERNAME=YOUR_TURN_USERNAME
TURN_CREDENTIAL=YOUR_TURN_CREDENTIAL
TURN_REALM=YOUR_APP_DOMAIN

# FFmpeg (recording, replay, clip generation)
FFMPEG_PATH=/usr/local/bin/ffmpeg
FFPROBE_PATH=/usr/local/bin/ffprobe

# NamVibe AI Platform (optional, disabled by default)
NAMVIBE_AI_ENABLED=false
NAMVIBE_AI_PROVIDER=disabled
NAMVIBE_AI_MODEL=
NAMVIBE_AI_API_KEY=YOUR_AI_API_KEY
NAMVIBE_AI_BASE_URL=YOUR_AI_BASE_URL
NAMVIBE_AI_TIMEOUT_SECONDS=12
NAMVIBE_AI_MAX_RETRIES=1
NAMVIBE_AI_RECOMMENDATIONS_ENABLED=false
NAMVIBE_AI_INTERACTION_TRACKING_ENABLED=true
NAMVIBE_AI_EXTERNAL_CALLS_ENABLED=false
NAMVIBE_AI_LOG_PROVIDER_USAGE=true
NAMVIBE_AI_CACHE_TTL_SECONDS=120
NAMVIBE_AI_RECOMMENDATION_VERSION=v1
