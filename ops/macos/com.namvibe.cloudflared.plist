<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.namvibe.cloudflared.plist — Launchd service for Cloudflare Tunnel

  INSTALLATION:
    cp ops/macos/com.namvibe.cloudflared.plist ~/Library/LaunchAgents/
    # Edit ~/Library/LaunchAgents/com.namvibe.cloudflared.plist to update paths
    launchctl load ~/Library/LaunchAgents/com.namvibe.cloudflared.plist

  UNINSTALL:
    launchctl unload ~/Library/LaunchAgents/com.namvibe.cloudflared.plist

  REQUIREMENTS:
    - Replace __PROJECT_ROOT__ with absolute path to project root
    - Replace __TUNNEL_ID__ with your tunnel ID
    - Cloudflared must be installed: brew install cloudflared
    - Cloudflare tunnel must be configured: cloudflared tunnel login
    - Config at ~/.cloudflared/config.yml must route to localhost:8080

  TROUBLESHOOTING:
    Check logs: cat __PROJECT_ROOT__/logs/cloudflared_launchd.log
    View status: launchctl list com.namvibe.cloudflared
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.namvibe.cloudflared</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/cloudflared</string>
        <string>tunnel</string>
        <string>run</string>
        <string>--config</string>
        <string>__HOME__/.cloudflared/config.yml</string>
        <string>__TUNNEL_ID__</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>__PROJECT_ROOT__/logs/cloudflared_launchd.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT_ROOT__/logs/cloudflared_launchd.log</string>
</dict>
</plist>
